---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/realms.css';
import '../styles/base.css';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE, type Realm } from '../config/site';
import frauncesUrl from '@fontsource-variable/fraunces/files/fraunces-latin-full-normal.woff2?url';
import instrumentUrl from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  realm?: Realm;
  /** Absolute or root-relative path to a 1200×630 image. */
  ogImage?: string;
  noindex?: boolean;
  /** schema.org JSON-LD object(s), e.g. SoftwareApplication on product pages. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Let the nav float over a full-bleed hero. */
  overlayNav?: boolean;
}

const {
  title,
  description,
  realm = 'house',
  // TODO(og): replace with designed Open Graph images per page.
  ogImage = '/og/default.jpg',
  noindex = false,
  schema,
  overlayNav = false,
} = Astro.props;

const fullTitle = title === SITE.name ? `${SITE.name} — ${SITE.tagline}` : `${title} · ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogUrl = new URL(ogImage, Astro.site);
const themeColor = { house: '#f2efe9', fantasy: '#15110b', scifi: '#060a1a', threshold: '#0b0c18', liminal: '#e6ece8', dungeon: '#0b0909', radiant: '#f6f1e4' }[realm];
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={instrumentUrl} as="font" type="font/woff2" crossorigin />

    <script is:inline>document.documentElement.classList.add('js');</script>

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <!--
      ANALYTICS (TODO(analytics)): no trackers, no cookies.
      When you've chosen a privacy-friendly, cookieless provider
      (e.g. Plausible, Fathom, or Cloudflare Web Analytics), paste its single
      script tag here and update /legal/privacy to name it.
    -->

    <!--
      MOONBASE STOREFRONT (TODO(moonbase)): disabled until the store is set up.
      To enable it:
        1. Fill in src/config/store.ts (account URL + product IDs).
        2. Uncomment the script tag below.
        3. Set STORE.enabled = true in src/config/store.ts.
      Buy / Add to cart / Download Lite buttons then call Moonbase through
      src/scripts/store.ts. See README → "Enabling Moonbase".

      <script type="module" src="https://assets.moonbase.sh/storefront/moonbase.js"></script>
    -->
  </head>
  <body data-realm={realm}>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteNav overlay={overlayNav} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
