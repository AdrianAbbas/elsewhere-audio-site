---
// A card with optional media. If `href` is set, the whole card is clickable
// (the title link is stretched over it) while keeping one clear link name.
interface Props {
  title: string;
  href?: string;
  eyebrow?: string;
  meta?: string;
  headingLevel?: 2 | 3 | 4;
  class?: string;
}
const { title, href, eyebrow, meta, headingLevel = 3, class: className } = Astro.props;
const H = `h${headingLevel}` as 'h2' | 'h3' | 'h4';
const hasMedia = Astro.slots.has('media');
---
<article class:list={['card', { 'card--link': href }, className]}>
  {hasMedia && <div class="card__media"><slot name="media" /></div>}
  <div class="card__body">
    {eyebrow && <p class="eyebrow card__eyebrow">{eyebrow}</p>}
    <H class="card__title">{href ? <a href={href}>{title}</a> : title}</H>
    <div class="card__text"><slot /></div>
    {meta && <p class="card__meta">{meta}</p>}
  </div>
</article>

<style>
  .card {
    position: relative; display: flex; flex-direction: column;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
    overflow: hidden;
    transition: border-color var(--dur-calm) var(--ease-out), transform var(--dur-calm) var(--ease-out);
  }
  .card__media { aspect-ratio: 4 / 3; overflow: hidden; background: var(--bg-deep); }
  .card__media > :global(*) { width: 100%; height: 100%; object-fit: cover; transition: transform var(--dur-slow) var(--ease-out); }
  .card__body { display: grid; gap: var(--space-2xs); padding: var(--space-m); }
  .card__title { font-size: var(--step-2); }
  .card__title a { color: inherit; text-decoration: none; }
  .card__title a::after { content: ''; position: absolute; inset: 0; }
  .card__text { color: var(--ink-muted); font-size: var(--step--1); }
  .card__meta { margin-top: var(--space-2xs); font-family: var(--font-mono); font-size: var(--step--2); letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent-text); }
  .card--link:hover { border-color: var(--line-strong); }
  .card--link:hover .card__media > :global(*) { transform: scale(1.03); }
  .card--link:has(a:focus-visible) { outline: 2px solid var(--focus); outline-offset: 3px; }
  .card--link a:focus-visible { outline: none; }

  /* Fantasy: an inner gilt frame */
  :global([data-realm='fantasy']) .card { border-radius: 1px; border-color: var(--line-strong); }
  :global([data-realm='fantasy']) .card::before {
    content: ''; position: absolute; inset: 6px; pointer-events: none; z-index: 1;
    border: 1px solid rgb(179 138 53 / 0.55);
  }
  :global([data-realm='fantasy']) .card__meta { font-family: var(--font-display); font-style: italic; text-transform: none; letter-spacing: 0; font-size: var(--step--1); }

  /* Sci-fi: square corners, hairlines, corner brackets */
  :global([data-realm='scifi']) .card { border-radius: 0; background: color-mix(in srgb, var(--surface) 85%, transparent); }
  :global([data-realm='scifi']) .card::after {
    content: ''; position: absolute; inset: -1px; pointer-events: none;
    background:
      linear-gradient(var(--accent-2), var(--accent-2)) 0 0 / 10px 1px no-repeat,
      linear-gradient(var(--accent-2), var(--accent-2)) 0 0 / 1px 10px no-repeat,
      linear-gradient(var(--accent-2), var(--accent-2)) 100% 100% / 10px 1px no-repeat,
      linear-gradient(var(--accent-2), var(--accent-2)) 100% 100% / 1px 10px no-repeat;
  }
  :global([data-realm='threshold']) .card { border-radius: 2px; }
</style>
