---
// "More worlds coming": atmosphere only. No product names, by design.
import Atmosphere, { type Scene } from './art/Atmosphere.astro';
interface Props { scene: Scene; alt: string; when?: string }
const { scene, alt, when = 'Coming 2027' } = Astro.props;
---
<figure class="teaser">
  <div class="teaser__art"><Atmosphere scene={scene} alt={alt} /></div>
  <figcaption class="teaser__when">{when}</figcaption>
</figure>

<style>
  .teaser { position: relative; margin: 0; border: 1px solid var(--line); border-radius: 6px; overflow: hidden; background: var(--bg-deep); }
  .teaser__art { aspect-ratio: 4 / 5; }
  .teaser__art :global(svg) { width: 100%; height: 100%; transition: transform var(--dur-slow) var(--ease-out), filter var(--dur-slow) var(--ease-out); filter: saturate(0.85) brightness(0.9); }
  .teaser:hover .teaser__art :global(svg) { transform: scale(1.04); filter: none; }
  .teaser__when {
    position: absolute; inset: auto 0 0; padding: var(--space-l) var(--space-m) var(--space-m);
    background: linear-gradient(transparent, rgb(7 7 15 / 0.88));
    color: #f2ecdf; font-size: var(--step--2); letter-spacing: 0.22em; text-transform: uppercase;
  }
</style>
