---
// Email sign-up PLACEHOLDER. Nothing is sent or stored anywhere.
// TODO(signup): connect a privacy-friendly newsletter provider, point the form
// at it (action/method or a fetch call) and update /legal/privacy.
interface Props { id?: string; heading?: string; text?: string }
const {
  id = 'signup',
  heading = 'Hear when the next door opens.',
  // TODO(copy): sign-up blurb.
  text = 'One short letter when a new world is ready. No spam, and you can leave at any time.',
} = Astro.props;
---
<form class="signup" data-signup aria-labelledby={`${id}-title`} novalidate>
  <h2 id={`${id}-title`} class="signup__title">{heading}</h2>
  <p class="signup__text">{text}</p>
  <div class="signup__row">
    <label class="visually-hidden" for={`${id}-email`}>Email address</label>
    <input id={`${id}-email`} name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
    <button class="btn btn--primary" type="submit">Notify me</button>
  </div>
  <p class="signup__status" role="status" data-signup-status></p>
</form>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-signup]')) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const status = form.querySelector<HTMLElement>('[data-signup-status]')!;
      const input = form.querySelector<HTMLInputElement>('input[type="email"]')!;
      if (!input.checkValidity()) {
        status.textContent = 'Please enter a valid email address.';
        input.focus();
        return;
      }
      // TODO(signup): send to the newsletter provider here.
      status.textContent = 'Thank you. Sign-up isn’t connected yet, so nothing was sent.';
    });
  }
</script>

<style>
  .signup { display: grid; gap: var(--space-s); max-width: 36rem; }
  .signup__title { font-size: var(--step-3); }
  .signup__text { color: var(--ink-muted); }
  .signup__row { display: flex; flex-wrap: wrap; gap: var(--space-xs); margin-top: var(--space-2xs); }
  .signup input {
    flex: 1 1 14rem; min-height: 2.9rem; padding: 0.6em 1em;
    background: var(--surface); color: var(--ink);
    border: 1px solid var(--line-strong); border-radius: var(--radius);
  }
  .signup input::placeholder { color: var(--ink-muted); opacity: 1; }
  :global([data-realm='threshold']) .signup input { border-radius: 999px; padding-inline: 1.3em; }
  .signup__status { min-height: 1.6em; font-size: var(--step--1); color: var(--ink-muted); }
</style>
