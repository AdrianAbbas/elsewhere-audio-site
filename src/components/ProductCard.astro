---
// A product in the line-up, in the style of the page it sits on. Following
// the card morphs its art into the product page's hero: motion.ts names the
// art (data-vt) at the moment of navigation, so only that card morphs.
import { Picture } from 'astro:assets';
import type { Product } from '../data/products';

/** row: the card is laid out as a row (art beside text) from 48rem, as on the home page. */
interface Props { product: Product; headingLevel?: 2 | 3; eager?: boolean; row?: boolean }
const { product: p, headingLevel = 3, eager = false, row = false } = Astro.props;
const H = `h${headingLevel}` as 'h2' | 'h3';
// The frame is 16:10 and the art is cropped to fill it (object-fit: cover), so
// wide art is drawn wider than the card. Ask for a source wide enough for that.
const img = p.card.image;
const f = Math.max(1, img.width / img.height / (16 / 10));
const vw = (n: number) => `${Math.min(200, Math.round(n * f))}vw`;
// Phones have dense screens, so the plain 100vw source is already sharp there.
const sizes = row ? `(min-width: 48rem) ${vw(42)}, 100vw` : `(min-width: 70rem) ${vw(30)}, (min-width: 40rem) ${vw(50)}, 100vw`;
const widths = [480, 720, 960, 1200, 1440].filter((w) => w <= img.width);
---
<article class="pcard">
  <div class="pcard__media" data-vt={`product-${p.slug}`} data-vt-href={`/${p.slug}`}>
    {p.card.pixel ? (
      <img class="pcard__pixel" src={p.card.image.src} width={p.card.image.width} height={p.card.image.height} alt={p.card.alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    ) : <Picture src={p.card.image} formats={['avif', 'webp']} fallbackFormat="webp" widths={widths} sizes={sizes} alt={p.card.alt} loading={eager ? 'eager' : 'lazy'} />}
  </div>
  <div class="pcard__body">
    <p class="pcard__meta"><span>{p.number}</span> · {p.kind}</p>
    <H class="pcard__name"><a href={`/${p.slug}`}>{p.name}</a></H>
    <p class="pcard__tagline">{p.tagline}</p>
    <p class="pcard__summary">{p.summary}</p>
    <p class:list={['pcard__status', { 'pcard__status--live': p.available }]}>{p.status}</p>
  </div>
</article>

<style>
  .pcard { position: relative; display: flex; flex-direction: column; border: 1px solid var(--line-strong); overflow: hidden; }
  .pcard__media { aspect-ratio: 16 / 10; overflow: hidden; background: var(--bg-deep); }
  .pcard__media :global(picture), .pcard__media :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .pcard__media :global(.pcard__pixel) { image-rendering: pixelated; object-position: 50% 30%; }
  .pcard__body { display: grid; gap: var(--space-2xs); align-content: start; padding: var(--space-m); flex: 1; }
  .pcard__meta { font-family: var(--eyebrow-font); font-style: var(--eyebrow-style); font-size: var(--step--2); letter-spacing: var(--eyebrow-tracking); text-transform: uppercase; color: var(--accent-text); }
  .pcard__name { font-size: var(--step-2); letter-spacing: 0.03em; }
  .pcard__name a { color: inherit; text-decoration: none; }
  .pcard__name a::after { content: ''; position: absolute; inset: 0; }
  .pcard:has(a:focus-visible) { outline: 2px solid var(--focus); outline-offset: 3px; }
  .pcard__name a:focus-visible { outline: none; }
  .pcard__tagline { font-family: var(--font-display); font-style: italic; color: var(--ink); }
  .pcard__summary { font-size: var(--step--1); color: var(--ink-muted); }
  .pcard__status { margin-top: auto; padding-top: var(--space-xs); font-family: var(--font-mono); font-size: var(--step--2); letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-muted); }
  .pcard__status--live { color: var(--accent-text); }
</style>
