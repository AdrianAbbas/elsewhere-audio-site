---
// The Stone Gate mark, from public/brand/. Below about 48 px the brand rules
// call for the simplified favicon drawing, so small marks use that file.
import type { Tone } from '../config/site';

interface Props {
  size?: number;
  /** Background the mark sits on. */
  tone?: Tone;
  class?: string;
  /** Leave empty for a decorative repeat (it is then hidden from screen readers). */
  alt?: string;
}
const { size = 28, tone = 'dark', class: className, alt = '' } = Astro.props;
const src = size < 48 ? '/brand/icon/windward-favicon.svg' : `/brand/mark/windward-mark-for-${tone}.svg`;
---
<img
  class={className}
  src={src}
  width={size}
  height={size}
  alt={alt}
  aria-hidden={alt ? undefined : 'true'}
  loading="lazy"
  decoding="async"
/>
