---
// The mark: a doorway standing on a horizon, with a sun (or a planet) setting
// inside it. Drawn in currentColor so it takes the colour of its realm.
interface Props { size?: number; class?: string }
const { size = 28, class: className } = Astro.props;
---
<svg class={className} width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false">
  <path d="M8 28V14.5a8 8 0 0 1 16 0V28" stroke="currentColor" stroke-width="1.5" />
  <path d="M8 22h16" stroke="currentColor" stroke-width="1" opacity=".55" />
  <path d="M13 22a3 3 0 0 1 6 0" stroke="currentColor" stroke-width="1.5" />
  <circle cx="20.5" cy="12.5" r=".9" fill="currentColor" />
  <path d="M3 28h26" stroke="currentColor" stroke-width="1.5" />
</svg>
