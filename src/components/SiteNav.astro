---
import Logo from './Logo.astro';
import { NAV, type Tone } from '../config/site';

interface Props {
  /** Render as a plain <div> (used for previews on /styleguide, to avoid duplicate landmarks). */
  preview?: boolean;
  /** Accessible name for the <nav>. */
  label?: string;
  /** Unique suffix when more than one nav is on a page. */
  id?: string;
  /** Sit transparently on top of a hero (home page). */
  overlay?: boolean;
  /** The header's background, for the logo's light or dark version. */
  tone?: Tone;
}
const { preview = false, label = 'Primary', id = 'main', overlay = false, tone = 'dark' } = Astro.props;
const Tag = preview ? 'div' : 'header';
const menuId = `site-menu-${id}`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<Tag class:list={['site-header', { 'site-header--overlay': overlay, 'site-header--main': !preview }]} data-realm="house">
  <div class="site-header__inner wrap-wide">
    <Logo tone={tone} />
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls={menuId} data-nav-toggle>
      <span class="nav-toggle__bars" aria-hidden="true"></span>
      <span>Menu</span>
    </button>
    <nav class="site-nav" id={menuId} aria-label={label}>
      <ul class="site-nav__list" role="list">
        {NAV.map((item) => (
          <li><a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
      <a class="site-nav__account" href="/account" aria-current={path === '/account' ? 'page' : undefined}>Account</a>
    </nav>
  </div>
</Tag>

<script>
  // Small-screen menu: a disclosure button. Escape closes it and returns focus.
  for (const toggle of document.querySelectorAll<HTMLButtonElement>('[data-nav-toggle]')) {
    const menu = document.getElementById(toggle.getAttribute('aria-controls') ?? '');
    if (!menu) continue;
    const set = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.dataset.open = String(open);
    };
    toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { set(false); toggle.focus(); }
    });
  }
</script>

<style>
  .site-header { container-type: inline-size; position: relative; z-index: 10; }
  .site-header--overlay { position: absolute; inset: 0 0 auto; background: transparent; }
  .site-header:not(.site-header--overlay) { border-bottom: 1px solid var(--line); }
  /* The nav and logo hold still while the page cross-fades (view transitions). */
  .site-header--main { view-transition-name: site-header; }
  .site-header--main :global(.logo) { view-transition-name: site-logo; }
  .site-header__inner {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-m);
    padding-block: var(--space-m);
  }

  .site-nav { display: flex; align-items: center; gap: var(--space-l); }
  .site-nav__list { display: flex; gap: var(--space-l); padding: 0; margin: 0; list-style: none; }
  .site-nav a {
    color: var(--ink); text-decoration: none; font-size: var(--step--1);
    padding-block: 0.4em; border-bottom: 1px solid transparent;
    transition: border-color var(--dur-quick) var(--ease-out), color var(--dur-quick) var(--ease-out);
  }
  .site-nav a:hover { border-bottom-color: var(--ink); }
  .site-nav a[aria-current='page'] { border-bottom-color: var(--accent); }
  .site-nav__account {
    padding: 0.45em 1em !important; border: 1px solid var(--line-strong) !important; border-radius: 1px;
  }
  .site-nav__account:hover { border-color: var(--ink) !important; }

  /* Realm personality */

  .nav-toggle {
    display: none; align-items: center; gap: 0.6em;
    padding: 0.5em 0.9em; border: 1px solid var(--line-strong); border-radius: 1px;
    background: transparent; cursor: pointer; font-size: var(--step--1);
  }
  .nav-toggle__bars, .nav-toggle__bars::before {
    display: block; width: 14px; height: 1px; background: currentColor; position: relative;
  }
  .nav-toggle__bars { box-shadow: 0 -4px 0 currentColor; top: 2px; }
  .nav-toggle__bars::before { content: ''; top: 4px; }

  /* Collapses on narrow containers (not only narrow screens). Without JS the
     links simply stay visible and wrap. */
  @container (max-width: 46rem) {
    .site-header__inner { flex-wrap: wrap; }
    :global(.js) .nav-toggle { display: inline-flex; }
    :global(.js) .site-nav { display: none; }
    :global(.js) .site-nav[data-open='true'] {
      display: flex; flex-basis: 100%; flex-direction: column; align-items: flex-start;
      gap: var(--space-s); padding-block: var(--space-s) var(--space-2xs);
      border-top: 1px solid var(--line);
    }
    .site-nav, .site-nav__list { flex-wrap: wrap; gap: var(--space-s) var(--space-m); }
    :global(.js) .site-nav__list { flex-direction: column; gap: var(--space-2xs); }
  }
</style>
