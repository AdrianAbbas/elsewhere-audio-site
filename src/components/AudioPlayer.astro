---
// Accessible demo player.
// - Nothing loads until play is pressed (preload="none"; seeking is disabled until then).
// - Only one demo plays at a time, site-wide (see src/scripts/audio-player.ts).
// - Optional waveform, drawn from precomputed peaks so it costs no audio download.
import peaksData from '../data/audio-peaks.json';

interface Props {
  src: string;
  title: string;
  /** Short line under the title, e.g. the Place's mood. */
  caption?: string;
  /** Key into src/data/audio-peaks.json. Omit for a plain progress bar. */
  peaks?: keyof typeof peaksData;
  /** Seconds. Taken from the peaks file when available. */
  duration?: number;
  compact?: boolean;
}
const { src, title, caption, peaks, compact = false } = Astro.props;
const data = peaks ? peaksData[peaks] : undefined;
const duration = Astro.props.duration ?? data?.duration ?? 0;
const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;

const BAR = 4;
const bars = data?.peaks ?? [];
const waveWidth = bars.length * BAR;
const waveBars = bars.map((p, i) => {
  const h = Math.max(2, p * 34);
  return { x: i * BAR, y: (40 - h) / 2, h };
});
---
<div class:list={['player', { 'player--compact': compact }]} data-player data-state="idle">
  <audio preload="none" src={src} data-player-audio></audio>
  <button class="player__toggle" type="button" data-player-toggle aria-label={`Play demo: ${title}`}>
    <svg class="player__icon player__icon--play" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 2.8v10.4L13 8z" fill="currentColor" /></svg>
    <svg class="player__icon player__icon--pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 3h2.6v10H4zM9.4 3H12v10H9.4z" fill="currentColor" /></svg>
    <span class="player__spinner" aria-hidden="true"></span>
  </button>

  <div class="player__body">
    <div class="player__meta">
      <span class="player__title">{title}</span>
      <span class="player__time" aria-hidden="true"><span data-player-current>0:00</span> / {fmt(duration)}</span>
    </div>
    {caption && !compact && <p class="player__caption">{caption}</p>}

    <div class="player__track">
      {bars.length > 0 ? (
        <>
          <svg class="player__wave" viewBox={`0 0 ${waveWidth} 40`} preserveAspectRatio="none" aria-hidden="true">
            {waveBars.map((b) => <rect x={b.x} y={b.y} width="2" height={b.h} rx="1" />)}
          </svg>
          <svg class="player__wave player__wave--played" viewBox={`0 0 ${waveWidth} 40`} preserveAspectRatio="none" aria-hidden="true">
            {waveBars.map((b) => <rect x={b.x} y={b.y} width="2" height={b.h} rx="1" />)}
          </svg>
        </>
      ) : (
        <span class="player__line" aria-hidden="true"><span class="player__line-fill"></span></span>
      )}
      <input
        class="player__seek"
        type="range"
        min="0"
        max={duration}
        step="0.1"
        value="0"
        disabled
        aria-label={`Position in ${title}`}
        aria-valuetext={`0:00 of ${fmt(duration)}`}
        data-player-seek
      />
    </div>
  </div>
  <p class="visually-hidden" aria-live="polite" data-player-status></p>
  <noscript><audio class="player__native" controls preload="none" src={src}></audio></noscript>
</div>

<script>
  import '../scripts/audio-player';
</script>

<style>
  .player {
    --progress: 0;
    display: grid; grid-template-columns: auto 1fr; align-items: center; gap: var(--space-s);
    padding: var(--space-s);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--surface) 80%, transparent);
  }
  .player--compact { padding: var(--space-xs); gap: var(--space-xs); }

  .player__toggle {
    position: relative; display: grid; place-items: center;
    width: 2.75rem; height: 2.75rem; padding: 0;
    border: 1px solid var(--line-strong); border-radius: 50%;
    background: transparent; color: var(--ink); cursor: pointer;
    transition: background-color var(--dur-quick) var(--ease-out), color var(--dur-quick) var(--ease-out), border-color var(--dur-quick);
  }
  .player__toggle:hover { border-color: var(--ink); }
  [data-state='playing'] .player__toggle, [data-state='loading'] .player__toggle {
    background: var(--primary); color: var(--on-primary); border-color: var(--primary);
  }
  .player__icon { width: 1rem; height: 1rem; grid-area: 1 / 1; }
  .player__icon--pause, .player__spinner { display: none; }
  [data-state='playing'] .player__icon--play, [data-state='loading'] .player__icon--play { display: none; }
  [data-state='playing'] .player__icon--pause { display: block; }
  [data-state='loading'] .player__spinner {
    display: block; grid-area: 1 / 1; width: 1.1rem; height: 1.1rem; border-radius: 50%;
    border: 1.5px solid currentColor; border-right-color: transparent;
    animation: player-spin 0.9s linear infinite;
  }
  @keyframes player-spin { to { transform: rotate(1turn); } }

  .player__body { min-width: 0; }
  .player__meta { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-xs); }
  .player__title { font-size: var(--step--1); font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .player__time { font-family: var(--font-mono); font-size: var(--step--2); color: var(--ink-muted); font-variant-numeric: tabular-nums; flex: none; }
  .player__caption { font-size: var(--step--1); color: var(--ink-muted); line-height: 1.4; margin-top: 0.15em; }

  .player__track { position: relative; height: 2.25rem; margin-top: var(--space-2xs); border-radius: 2px; }
  .player--compact .player__track { height: 1.5rem; margin-top: 0.2rem; }
  .player__track:has(.player__seek:focus-visible) { outline: 2px solid var(--focus); outline-offset: 3px; }

  .player__wave { position: absolute; inset: 0; width: 100%; height: 100%; fill: var(--line-strong); }
  .player__wave--played {
    fill: var(--accent-text);
    clip-path: inset(0 calc(100% - var(--progress) * 100%) 0 0);
  }
  .player__line { position: absolute; inset: 50% 0 auto; height: 2px; translate: 0 -50%; background: var(--line-strong); }
  .player__line-fill { display: block; height: 100%; width: calc(var(--progress) * 100%); background: var(--accent-text); }

  .player__seek {
    position: absolute; inset: 0; width: 100%; height: 100%; margin: 0;
    opacity: 0; cursor: pointer;
  }
  .player__seek:disabled { cursor: default; }

  .player__native { width: 100%; margin-top: var(--space-xs); grid-column: 1 / -1; }

  [data-state='error'] .player__toggle { opacity: 0.5; cursor: not-allowed; }

  /* Realm personality */
  :global([data-realm='scifi']) .player { border-radius: 0; border-color: var(--line-strong); }
  :global([data-realm='scifi']) .player__toggle { border-radius: 0; }
  :global([data-realm='fantasy']) .player { box-shadow: inset 0 0 0 3px var(--surface), inset 0 0 0 4px var(--line); }
  :global([data-realm='fantasy']) .player__title { font-family: var(--font-display); font-variation-settings: var(--display-variation); font-size: var(--step-0); font-weight: 450; }
</style>
