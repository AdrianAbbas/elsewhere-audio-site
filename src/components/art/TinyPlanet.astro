---
// WORLDBUILDER's "tiny planet": pixel art, half fantasy (grass and a castle),
// half sci-fi (plating and a lit spire). Pixel art belongs ONLY to WORLDBUILDER
// surfaces; never use this component in site chrome (nav, footer, body type).
interface Props { size?: number; class?: string }
const { size = 192, class: className } = Astro.props;

const N = 40, cx = 20, cy = 25, R = 13;
const bayer = [[0, 8, 2, 10], [12, 4, 14, 6], [3, 11, 1, 9], [15, 7, 13, 5]];
const grass = ['#16291f', '#2f5a35', '#5f8f45', '#a3c464'];
const plate = ['#101540', '#273278', '#4a5bb8', '#8b98e6'];
const grid: (string | null)[][] = Array.from({ length: N }, () => Array(N).fill(null));
const put = (x: number, y: number, c: string) => { if (x >= 0 && y >= 0 && x < N && y < N) grid[y][x] = c; };

for (let y = 0; y < N; y++) {
  for (let x = 0; x < N; x++) {
    const dx = x + 0.5 - cx, dy = y + 0.5 - cy, d = Math.hypot(dx, dy);
    if (d <= R) {
      const light = (-dx * 0.62 - dy * 0.78) / R; // lit from the upper left
      const v = light + 0.35 + (bayer[y % 4][x % 4] / 16 - 0.5) * 0.45;
      const tone = v > 0.75 ? 3 : v > 0.25 ? 2 : v > -0.3 ? 1 : 0;
      const pal = x < cx ? grass : plate;
      let c = pal[tone];
      if (x >= cx && (y % 5 === 0 || x % 6 === 0) && tone > 0) c = pal[tone - 1]; // panel seams
      put(x, y, c);
    } else if (d <= R + 1.1) {
      put(x, y, x < cx ? '#e3b56655' : '#6fd6cb66'); // thin atmosphere
    }
  }
}
const surface = (x: number) => Math.round(cy - Math.sqrt(R * R - (x + 0.5 - cx) ** 2));
const sprite = (rows: string[], left: number, colors: Record<string, string>) => {
  const base = surface(left + Math.floor(rows[0].length / 2)) + 1;
  rows.forEach((row, i) => [...row].forEach((ch, j) => { if (colors[ch]) put(left + j, base - rows.length + i, colors[ch]); }));
};
sprite(['.#...#.', '.#...#.', '###.###', '#######', '##w#w##', '#######'], 10, { '#': '#8a7553', w: '#ffd27a' });
sprite(['..#..', '..c..', '.###.', '.#c#.', '.###.', '##c##', '#####'], 23, { '#': '#c9d2ff', c: '#6fe3d6' });
for (const [x, y] of [[4, 6], [33, 4], [36, 14], [8, 15], [27, 2], [2, 30], [37, 31]]) put(x, y, '#f3ebd6');
put(14, 3, '#f2c46b'); // a warm star on the fantasy side

// Merge horizontal runs of the same colour into single rects.
const rects: { x: number; y: number; w: number; c: string }[] = [];
grid.forEach((row, y) => {
  for (let x = 0; x < N; ) {
    const c = row[x];
    let w = 1;
    while (c && row[x + w] === c) w++;
    if (c) rects.push({ x, y, w, c });
    x += w;
  }
});
---
<svg class:list={['tiny-planet', className]} width={size} height={size} viewBox={`0 0 ${N} ${N}`} shape-rendering="crispEdges" role="img" aria-label="Pixel-art tiny planet: one half grassland with a small castle, the other half metal plating with a lit spire.">
  {rects.map((p) => <rect x={p.x} y={p.y} width={p.w} height="1" fill={p.c} />)}
</svg>
