---
// The threshold: one horizon, two worlds. A painted image (rendered by
// `npm run art` from scripts/art/threshold.mjs, served as responsive AVIF/WebP)
// with a tiny inline overlay for the living details: a few twinkling stars,
// the castle's candle and the spire's beacon. Motion is CSS only and is off
// under reduced motion.
import { Picture } from 'astro:assets';
import art from '../../assets/art/threshold.webp';
import overlay from '../../data/threshold-overlay.json';
import { seeded, round } from '../../lib/random';

interface Props { label?: string }
const { label = 'Introduction' } = Astro.props;

const r = seeded(5);
const twinkles = Array.from({ length: 14 }, () => ({
  x: round(900 + r() * 680), y: round(30 + r() * 300), rad: round(0.5 + r() * 0.5, 2), d: round(-r() * 5, 2),
}));
---
<section class="threshold-hero" aria-label={label}>
  <div class="threshold-hero__art">
    <Picture
      src={art}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      widths={[800, 1200, 1600, 2400]}
      sizes="(max-aspect-ratio: 2/1) 215svh, 100vw"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      alt="A single horizon at dusk. On the left, ridges fade into a sunset haze and a distant castle shows one lit window. On the right, a city of towers stands in cool mist beneath stars and a vast planet lit along one edge. Between them, a slender doorway glows on the horizon."
    />
    <svg class="threshold-hero__overlay" viewBox="0 0 1600 760" preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false">
      <defs>
        <radialGradient id="th-glow"><stop offset="0" stop-color="#ffd08a" stop-opacity=".9" /><stop offset="1" stop-color="#ffd08a" stop-opacity="0" /></radialGradient>
      </defs>
      {twinkles.map((t) => <circle class="th-twinkle" cx={t.x} cy={t.y} r={t.rad} fill="#fff" style={`animation-delay:${t.d}s`} />)}
      <circle class="th-flicker" cx={overlay.castleWindow.x} cy={overlay.castleWindow.y} r="4" fill="url(#th-glow)" />
      <circle class="th-beacon" cx={overlay.beacon.x} cy={overlay.beacon.y} r="1.4" fill="#9fe9e0" />
    </svg>
  </div>

  <div class="threshold-hero__content wrap">
    <slot />
  </div>
</section>

<style>
  .threshold-hero {
    position: relative;
    isolation: isolate;
    min-height: clamp(36rem, 92svh, 58rem);
    display: grid;
    align-items: start;
    overflow: hidden;
    view-timeline: --threshold block;
  }
  .threshold-hero__art {
    position: absolute; inset: 0; z-index: -1;
    -webkit-mask-image: linear-gradient(#000 86%, transparent);
    mask-image: linear-gradient(#000 86%, transparent);
  }
  .threshold-hero__art :global(picture) { display: block; width: 100%; height: 100%; }
  .threshold-hero__art :global(img) {
    width: 100%; height: 100%;
    object-fit: cover; object-position: 50% 100%;
  }
  .threshold-hero__overlay { position: absolute; inset: 0; width: 100%; height: 100%; }
  /* The page's grain over the painting, so it sits in the same paper as everything else */
  .threshold-hero::after {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: var(--grain-light) 0 0 / 200px 200px;
    -webkit-mask-image: linear-gradient(#000 80%, transparent);
    mask-image: linear-gradient(#000 80%, transparent);
  }
  .threshold-hero__content {
    padding-block: clamp(6rem, 13svh, 9rem) 16rem;
    text-align: center;
    display: grid; justify-items: center; gap: var(--space-m);
  }
  /* A soft scrim keeps text contrast steady over the sky. */
  .threshold-hero__content::before {
    content: ''; position: absolute; inset: 0 0 35%; z-index: -1; pointer-events: none;
    background: radial-gradient(ellipse 60% 55% at 50% 38%, rgb(11 12 24 / 0.5), transparent 78%);
  }

  .th-twinkle, .th-beacon { opacity: 0.6; }
  @media (prefers-reduced-motion: no-preference) {
    .th-twinkle { animation: th-twinkle 4.5s ease-in-out infinite alternate; }
    .th-flicker { animation: th-flicker 3.2s ease-in-out infinite; }
    .th-beacon { animation: th-twinkle 2.4s ease-in-out infinite alternate; }

    /* Gentle parallax: the painting drifts slower than the page, the words lift away. */
    @supports (animation-timeline: view()) {
      .threshold-hero__art, .threshold-hero__content {
        animation: linear both;
        animation-timeline: --threshold;
        animation-range: cover 50% cover 100%;
      }
      .threshold-hero__art { animation-name: th-drift; }
      .threshold-hero__content { animation-name: th-content; }
    }
  }
  @keyframes th-twinkle { from { opacity: 0.1; } to { opacity: 0.9; } }
  @keyframes th-flicker { 0%, 100% { opacity: 1; } 45% { opacity: 0.55; } 55% { opacity: 0.95; } 70% { opacity: 0.7; } }
  @keyframes th-drift { to { transform: translateY(18%) scale(1.04); } }
  @keyframes th-content { to { transform: translateY(-60px); opacity: 0; } }
</style>
