---
// The threshold: one horizon, two worlds. Fantasy at dusk on the left,
// a sci-fi skyline under the stars on the right, a lit doorway between them.
// Pure inline SVG (no image requests); details are generated from a fixed seed.
// Parallax uses CSS scroll-driven animations and is off under reduced motion.
import { seeded, round } from '../../lib/random';

interface Props { id?: string; label?: string }
const { id = 'th', label = 'Introduction' } = Astro.props;
const r = seeded(7);
const H = 660; // horizon

// Stars: dense on the cool (right) side, a few early ones on the warm side.
const stars = Array.from({ length: 150 }, () => {
  const x = r() < 0.86 ? 760 + r() * 840 : r() * 760;
  const y = r() * (x > 800 ? 560 : 300);
  const warm = x < 800;
  return { x: round(x), y: round(y), rad: round(warm ? 0.6 + r() * 0.6 : 0.4 + r() * 1.1), o: round((warm ? 0.35 : 0.45) + r() * 0.5, 2), tw: r() < 0.1 };
});

// Far towers (hazy) and the near skyline with lit windows.
const farTowers: { x: number; w: number; h: number }[] = [];
for (let x = 960; x < 1600; ) {
  const w = 18 + r() * 34;
  farTowers.push({ x: round(x), w: round(w), h: round(70 + r() * 210) });
  x += w + r() * 14;
}
const towers: { x: number; w: number; h: number }[] = [];
const windows: { x: number; y: number; c: string }[] = [];
for (let x = 960; x < 1600; ) {
  const w = 26 + r() * 40;
  const h = 90 + r() * 260 * (x > 1150 ? 1 : 0.6);
  towers.push({ x: round(x), w: round(w), h: round(h) });
  for (let wy = H - h + 10; wy < H - 14; wy += 9) {
    for (let wx = x + 5; wx < x + w - 6; wx += 7) {
      if (r() < 0.13) windows.push({ x: round(wx), y: round(wy), c: r() < 0.6 ? '#6fd6cb' : r() < 0.6 ? '#b9adff' : '#e8ecff' });
    }
  }
  x += w + 2 + r() * 10;
}

// Pines along the dusk hill (approximate the hill's top edge).
const hillY = (x: number) => 700 - Math.sin((Math.min(x, 470) / 470) * Math.PI * 0.5) * 92 + Math.max(0, x - 470) * 0.24;
const pines = [] as { x: number; y: number; s: number }[];
for (let x = 20; x < 420; x += 16 + r() * 20) {
  pines.push({ x: round(x), y: round(hillY(x) + 6), s: round(0.7 + r() * 0.7, 2) });
}
const pine = (p: { x: number; y: number; s: number }) => {
  const s = p.s;
  return `M${p.x - 9 * s} ${p.y}L${p.x} ${p.y - 26 * s}L${p.x + 9 * s} ${p.y}ZM${p.x - 7 * s} ${p.y - 12 * s}L${p.x} ${p.y - 36 * s}L${p.x + 7 * s} ${p.y - 12 * s}Z`;
};
---
<section class="threshold-hero" aria-label={label}>
  <svg class="threshold-hero__art" viewBox="0 0 1600 760" preserveAspectRatio="xMidYMax slice" role="img" aria-labelledby={`${id}-alt`}>
    <title id={`${id}-alt`}>A single horizon at dusk. On the left, a castle and pine forest under a setting sun. On the right, a city of towers under a starry sky and a ringed planet. Between them stands a softly lit doorway.</title>
    <defs>
      <linearGradient id={`${id}-warm`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#191130" />
        <stop offset=".38" stop-color="#3a2142" />
        <stop offset=".6" stop-color="#77394b" />
        <stop offset=".76" stop-color="#bf634a" />
        <stop offset=".86" stop-color="#e99b5b" />
        <stop offset="1" stop-color="#f4c27b" />
      </linearGradient>
      <linearGradient id={`${id}-cool`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#03061a" />
        <stop offset=".45" stop-color="#0a1238" />
        <stop offset=".72" stop-color="#1b1d58" />
        <stop offset=".86" stop-color="#312e78" />
        <stop offset="1" stop-color="#4a3f8e" />
      </linearGradient>
      <linearGradient id={`${id}-seam`} x1="0" x2="1">
        <stop offset=".36" stop-color="#000" />
        <stop offset=".64" stop-color="#fff" />
      </linearGradient>
      <mask id={`${id}-coolmask`}><rect width="1600" height="900" fill={`url(#${id}-seam)`} /></mask>
      <radialGradient id={`${id}-sun`}>
        <stop offset="0" stop-color="#fff1c9" stop-opacity=".9" />
        <stop offset=".25" stop-color="#ffcf86" stop-opacity=".45" />
        <stop offset="1" stop-color="#ff9a55" stop-opacity="0" />
      </radialGradient>
      <radialGradient id={`${id}-violet`}>
        <stop offset="0" stop-color="#8c7bff" stop-opacity=".42" />
        <stop offset="1" stop-color="#8c7bff" stop-opacity="0" />
      </radialGradient>
      <radialGradient id={`${id}-teal`}>
        <stop offset="0" stop-color="#43d6c6" stop-opacity=".26" />
        <stop offset="1" stop-color="#43d6c6" stop-opacity="0" />
      </radialGradient>
      <linearGradient id={`${id}-planet`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#c9b8ff" />
        <stop offset=".45" stop-color="#5a4fb0" />
        <stop offset="1" stop-color="#151640" />
      </linearGradient>
      <linearGradient id={`${id}-door`} x1="0" x2="1">
        <stop offset="0" stop-color="#e3b566" />
        <stop offset="1" stop-color="#6fd6cb" />
      </linearGradient>
      <linearGradient id={`${id}-doorfill`} x1="0" x2="1">
        <stop offset="0" stop-color="#ffd79a" stop-opacity=".5" />
        <stop offset=".5" stop-color="#fff4dd" stop-opacity=".62" />
        <stop offset="1" stop-color="#a8f0e8" stop-opacity=".5" />
      </linearGradient>
      <radialGradient id={`${id}-doorglow`}>
        <stop offset="0" stop-color="#fff0cf" stop-opacity=".55" />
        <stop offset=".5" stop-color="#e3b566" stop-opacity=".14" />
        <stop offset="1" stop-color="#6fd6cb" stop-opacity="0" />
      </radialGradient>
      <linearGradient id={`${id}-trail`} x1="0" y1="1" x2="1" y2="0">
        <stop offset="0" stop-color="#6fd6cb" stop-opacity="0" />
        <stop offset="1" stop-color="#e8fffb" stop-opacity=".85" />
      </linearGradient>
      <mask id={`${id}-crescent`}>
        <circle cx="210" cy="150" r="17" fill="#fff" />
        <circle cx="218" cy="145" r="15" fill="#000" />
      </mask>
    </defs>

    <g class="th-layer th-sky">
      <rect width="1600" height="900" fill={`url(#${id}-warm)`} />
      <g mask={`url(#${id}-coolmask)`}>
        <rect width="1600" height="900" fill={`url(#${id}-cool)`} />
        <ellipse cx="1260" cy="250" rx="380" ry="230" fill={`url(#${id}-violet)`} />
        <ellipse cx="1480" cy="470" rx="260" ry="170" fill={`url(#${id}-teal)`} />
      </g>
      <circle cx="330" cy="650" r="330" fill={`url(#${id}-sun)`} />
      <circle cx="330" cy="664" r="54" fill="#ffd99a" opacity=".92" />
      <circle cx="210" cy="150" r="17" fill="#f6e2b5" opacity=".75" mask={`url(#${id}-crescent)`} />
      <g fill="#fff">
        {stars.map((s) => <circle class={s.tw ? 'th-twinkle' : undefined} cx={s.x} cy={s.y} r={s.rad} opacity={s.o} />)}
      </g>
      <g>
        <ellipse cx="1330" cy="190" rx="80" ry="14" transform="rotate(-16 1330 190)" fill="none" stroke="#a99dff" stroke-opacity=".4" stroke-width="1.5" />
        <circle cx="1330" cy="190" r="38" fill={`url(#${id}-planet)`} />
        <path d="M1250 190a80 14 0 0 0 160 0" transform="rotate(-16 1330 190)" fill="none" stroke="#c9c0ff" stroke-opacity=".75" stroke-width="1.5" />
      </g>
    </g>

    <g class="th-layer th-far">
      <path d="M0 610L70 552L130 585L230 512L320 566L410 528L500 590L600 566L700 612L790 650V900H0Z" fill="#4a2944" opacity=".9" />
      <path d="M0 640L110 600L190 622L290 588L380 618L470 600L560 630L660 626L780 660V900H0Z" fill="#331b33" />
      <g fill="#171c4a" opacity=".92">
        {farTowers.map((t) => <rect x={t.x} y={H - t.h} width={t.w} height={t.h} />)}
      </g>
    </g>

    <g class="th-layer th-mid">
      <path d="M0 700C150 650 300 606 470 608C600 612 690 646 780 680V900H0Z" fill="#24142a" />
      <g fill="#170c1c">{pines.map((p) => <path d={pine(p)} />)}</g>
      <g fill="#1a0f1f">
        <rect x="470" y="522" width="70" height="92" />
        <path d="M470 522h8v-8h6v8h8v-8h6v8h8v-8h6v8h8v-8h6v8h8v-8h6v8" />
        <rect x="440" y="490" width="30" height="125" />
        <path d="M435 491L455 446L475 491Z" />
        <rect x="540" y="470" width="28" height="145" />
        <path d="M535 471L554 420L573 471Z" />
        <path d="M554 420v-20" stroke="#1a0f1f" stroke-width="2" />
        <path d="M555 400l15 5l-15 5Z" />
        <rect x="568" y="562" width="66" height="52" />
        <path d="M568 562h6v-7h6v7h6v-7h6v7h6v-7h6v7h6v-7h6v7h6v-7h6v7h6v-7h4" />
      </g>
      <g fill="#ffc56e">
        <rect class="th-flicker" x="452" y="520" width="5" height="8" rx="2" />
        <rect x="498" y="548" width="5" height="10" rx="2.5" />
        <rect x="512" y="548" width="5" height="10" rx="2.5" />
        <rect class="th-flicker" x="551" y="498" width="5" height="8" rx="2" />
        <rect x="596" y="582" width="4" height="7" rx="2" opacity=".8" />
      </g>

      <g fill="#0a0e2c">
        {towers.map((t) => <rect x={t.x} y={H - t.h} width={t.w} height={t.h + 40} />)}
        <rect x="1236" y="232" width="12" height="440" />
        <path d="M1236 232L1242 150L1248 232Z" />
      </g>
      <g opacity=".75">
        {windows.map((w) => <rect x={w.x} y={w.y} width="2.4" height="3.4" fill={w.c} />)}
      </g>
      <circle class="th-beacon" cx="1242" cy="150" r="3" fill="#6fd6cb" />
      <path d="M1120 600L1452 318" stroke={`url(#${id}-trail)`} stroke-width="1.4" />
      <circle cx="1452" cy="318" r="2" fill="#e8fffb" />
    </g>

    <g class="th-layer th-near">
      <ellipse cx="800" cy="590" rx="190" ry="160" fill={`url(#${id}-doorglow)`} />
      <path d="M0 760C210 728 420 736 620 702C700 688 760 672 800 672C860 672 950 692 1100 694H1600V900H0Z" fill="#0b0c18" />
      <path d="M1100 694H1600" stroke="#6fd6cb" stroke-opacity=".35" />
      <g fill="#6fd6cb" opacity=".7">
        <rect x="1180" y="692" width="6" height="2" /><rect x="1300" y="692" width="6" height="2" /><rect x="1420" y="692" width="6" height="2" /><rect x="1540" y="692" width="6" height="2" />
      </g>
      <g stroke="#2a1a2c" stroke-width="1.5" stroke-linecap="round">
        <path d="M120 745l-4-14M124 745l2-16M128 745l6-12M330 728l-3-12M334 728l3-14M520 712l-3-12M524 712l4-11" />
      </g>
      <path d="M762 672V566a38 38 0 0 1 76 0V672Z" fill={`url(#${id}-doorfill)`} />
      <path d="M770 634H830" stroke="#fff" stroke-opacity=".5" />
      <path d="M788 634a12 12 0 0 1 24 0" stroke="#fff" stroke-opacity=".75" fill="none" stroke-width="1.5" />
      <path d="M762 672V566a38 38 0 0 1 76 0V672" fill="none" stroke={`url(#${id}-door)`} stroke-width="2.5" />
      <ellipse cx="800" cy="676" rx="150" ry="6" fill={`url(#${id}-doorglow)`} />
    </g>
  </svg>

  <div class="threshold-hero__content wrap">
    <slot />
  </div>
</section>

<style>
  .threshold-hero {
    position: relative;
    isolation: isolate;
    min-height: clamp(36rem, 92svh, 58rem);
    display: grid;
    align-items: start;
    overflow: hidden;
    view-timeline: --threshold block;
  }
  /* Same grain as the page, so the hero melts into what follows */
  .threshold-hero::after {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: var(--grain-light) 0 0 / 200px 200px;
    -webkit-mask-image: linear-gradient(#000 80%, transparent);
    mask-image: linear-gradient(#000 80%, transparent);
  }
  .threshold-hero__art {
    position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1;
    -webkit-mask-image: linear-gradient(#000 88%, transparent);
    mask-image: linear-gradient(#000 88%, transparent);
  }
  .threshold-hero__content {
    padding-block: clamp(6rem, 13svh, 9rem) 16rem;
    text-align: center;
    display: grid; justify-items: center; gap: var(--space-m);
  }
  /* A soft scrim keeps text contrast steady over the sky. */
  .threshold-hero__content::before {
    content: ''; position: absolute; inset: 0 0 35%; z-index: -1; pointer-events: none;
    background: radial-gradient(ellipse 60% 55% at 50% 38%, rgb(11 12 24 / 0.62), transparent 78%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .th-twinkle { animation: th-twinkle 3.6s ease-in-out infinite alternate; }
    .th-twinkle:nth-child(3n) { animation-delay: -1.2s; animation-duration: 5s; }
    .th-flicker { animation: th-flicker 2.8s ease-in-out infinite; }
    .th-beacon { animation: th-twinkle 1.8s ease-in-out infinite alternate; }

    @supports (animation-timeline: view()) {
      .th-layer, .threshold-hero__content {
        animation: linear both;
        animation-timeline: --threshold;
        animation-range: cover 50% cover 100%;
      }
      .th-sky { animation-name: th-sky; }
      .th-far { animation-name: th-far; }
      .th-mid { animation-name: th-mid; }
      .threshold-hero__content { animation-name: th-content; }
    }
  }
  @keyframes th-twinkle { from { opacity: 0.15; } to { opacity: 1; } }
  @keyframes th-flicker { 0%, 100% { opacity: 1; } 45% { opacity: 0.7; } 55% { opacity: 0.95; } 70% { opacity: 0.78; } }
  @keyframes th-sky { to { transform: translateY(140px); } }
  @keyframes th-far { to { transform: translateY(90px); } }
  @keyframes th-mid { to { transform: translateY(45px); } }
  @keyframes th-content { to { transform: translateY(-60px); opacity: 0; } }
</style>
