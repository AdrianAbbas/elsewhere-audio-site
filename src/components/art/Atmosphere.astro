---
// Atmospheric art for cards (e.g. the unnamed "coming soon" worlds).
// Painted by scripts/art/atmospheres.mjs, rendered with `npm run art`,
// served as responsive AVIF/WebP and lazy-loaded.
// TODO(images): replace with real artwork when it exists (same file names
// in src/assets/art/, or point the imports below at new files).
import { Picture } from 'astro:assets';
import forest from '../../assets/art/atmosphere-forest.webp';
import nebula from '../../assets/art/atmosphere-nebula.webp';
import ruins from '../../assets/art/atmosphere-ruins.webp';
import megacity from '../../assets/art/atmosphere-megacity.webp';

const ART = { forest, nebula, ruins, megacity };
export type Scene = keyof typeof ART;

interface Props { scene: Scene; alt: string; sizes?: string }
const { scene, alt, sizes = '(min-width: 70rem) 30vw, (min-width: 40rem) 50vw, 100vw' } = Astro.props;
---
<Picture
  class="atmosphere"
  src={ART[scene]}
  formats={['avif', 'webp']}
  fallbackFormat="webp"
  widths={[400, 600, 800]}
  sizes={sizes}
  alt={alt}
  loading="lazy"
  decoding="async"
  pictureAttributes={{ class: 'atmosphere-picture' }}
/>

<style>
  :global(.atmosphere-picture) { display: block; width: 100%; height: 100%; }
  :global(.atmosphere) { display: block; width: 100%; height: 100%; object-fit: cover; }
</style>
