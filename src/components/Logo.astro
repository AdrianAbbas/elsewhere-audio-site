---
import LogoMark from './LogoMark.astro';
interface Props { href?: string; size?: 'sm' | 'md' }
const { href = '/', size = 'md' } = Astro.props;
---
<a class:list={['logo', `logo--${size}`]} href={href} aria-label="Elsewhere Audio, home">
  <LogoMark size={size === 'sm' ? 24 : 30} class="logo__mark" />
  <span class="logo__word" aria-hidden="true">Elsewhere <span class="logo__sub">Audio</span></span>
</a>

<style>
  .logo {
    display: inline-flex; align-items: center; gap: 0.6rem;
    color: var(--ink); text-decoration: none; line-height: 1;
  }
  .logo:hover { color: var(--ink); }
  .logo__mark { color: var(--accent); flex: none; }
  .logo__word {
    font-family: var(--font-display);
    font-variation-settings: var(--display-variation);
    font-weight: 400;
    font-size: 1.3rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .logo--sm .logo__word { font-size: 1.1rem; }
  .logo__sub {
    font-family: var(--font-body);
    font-size: 0.56em;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    vertical-align: 0.2em;
    margin-inline-start: 0.15em;
    color: var(--ink-muted);
  }
</style>
