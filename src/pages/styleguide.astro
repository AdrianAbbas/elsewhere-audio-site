---
// INTERNAL: design direction for review. Not linked from the site,
// excluded from the sitemap and marked noindex.
import BaseLayout from '../layouts/BaseLayout.astro';
import RealmPanel from '../components/styleguide/RealmPanel.astro';
import ContrastTable from '../components/styleguide/ContrastTable.astro';
import ThresholdHero from '../components/art/ThresholdHero.astro';
import TinyPlanet from '../components/art/TinyPlanet.astro';
import Ornament from '../components/Ornament.astro';
import AudioPlayer from '../components/AudioPlayer.astro';

const scale = [
  ['--step-6', 'Hero'],
  ['--step-5', 'Page title'],
  ['--step-4', 'Section title'],
  ['--step-3', 'Sub-section'],
  ['--step-2', 'Card title'],
  ['--step-1', 'Lede'],
  ['--step-0', 'Body'],
  ['--step--1', 'Small'],
  ['--step--2', 'Labels'],
];
const space = ['3xs', '2xs', 'xs', 's', 'm', 'l', 'xl', '2xl', '3xl'];
---
<BaseLayout
  title="Styleguide"
  description="Internal design direction for the Windward Audio website."
  realm="house"
  noindex
>
  <div id="top" class="sg">
    <header class="sg-intro wrap stack">
      <p class="eyebrow">Styleguide · direction v0.1 · for review</p>
      <h1>One house, many realms.</h1>
      <p class="lede">
        The house is the logo’s night: ink and cream, with ember for anything you can press. Generous space, one serif with real character, a quiet sans, and grain
        you feel more than see. Each page then takes on the weather of its realm. Below: the house, the two realms side by
        side, the threshold that joins them, and the one place pixel art is allowed.
      </p>
      <nav aria-label="Styleguide sections" class="sg-toc">
        <a href="#logo">Logo</a>
        <a href="#house">The house</a>
        <a href="#realms">Realms</a>
        <a href="#threshold">Threshold hero</a>
        <a href="#identity">Product identity</a>
        <a href="#product-realms">Product realms</a>
      </nav>
    </header>

    <!-- ── LOGO ────────────────────────────────────────────────────── -->
    <section id="logo" class="sg-section wrap" aria-labelledby="logo-title">
      <h2 id="logo-title">Logo</h2>
      <p class="lede">The Stone Gate: a stone gateway with a gold keystone and two torches, opening onto a dusk sky where a lone ghost ship sits on still water under a pale moon. Files and rules are in <code>public/brand/</code> (see its README). Use <code>-for-dark</code> files on dark grounds and <code>-for-light</code> on light ones; below about 48&nbsp;px, use the simplified favicon.</p>

      <h3 class="sg-logo__label">Horizontal lockup (header, emails, banners)</h3>
      <div class="sg-logo__grid sg-logo__grid--2">
        <figure class="sg-logo__tile sg-logo__tile--dark"><img src="/brand/lockup/windward-horizontal-for-dark.svg" width="864" height="300" alt="Windward Audio horizontal logo, version for dark backgrounds" loading="lazy" /><figcaption>windward-horizontal-for-dark.svg</figcaption></figure>
        <figure class="sg-logo__tile sg-logo__tile--light"><img src="/brand/lockup/windward-horizontal-for-light.svg" width="864" height="300" alt="Windward Audio horizontal logo, version for light backgrounds" loading="lazy" /><figcaption>windward-horizontal-for-light.svg</figcaption></figure>
      </div>

      <h3 class="sg-logo__label">Stacked lockup (splash screens, posters, share image)</h3>
      <div class="sg-logo__grid sg-logo__grid--2">
        <figure class="sg-logo__tile sg-logo__tile--dark"><img class="sg-logo__stacked" src="/brand/lockup/windward-stacked-for-dark.svg" width="600" height="640" alt="Windward Audio stacked logo, version for dark backgrounds" loading="lazy" /><figcaption>windward-stacked-for-dark.svg</figcaption></figure>
        <figure class="sg-logo__tile sg-logo__tile--light"><img class="sg-logo__stacked" src="/brand/lockup/windward-stacked-for-light.svg" width="600" height="640" alt="Windward Audio stacked logo, version for light backgrounds" loading="lazy" /><figcaption>windward-stacked-for-light.svg</figcaption></figure>
      </div>

      <h3 class="sg-logo__label">Mark and one-colour marks</h3>
      <div class="sg-logo__grid sg-logo__grid--5">
        <figure class="sg-logo__tile sg-logo__tile--dark"><img class="sg-logo__mark" src="/brand/mark/windward-mark-for-dark.svg" width="300" height="300" alt="The Stone Gate mark, version for dark backgrounds" loading="lazy" /><figcaption>mark-for-dark</figcaption></figure>
        <figure class="sg-logo__tile sg-logo__tile--light"><img class="sg-logo__mark" src="/brand/mark/windward-mark-for-light.svg" width="300" height="300" alt="The Stone Gate mark, version for light backgrounds" loading="lazy" /><figcaption>mark-for-light</figcaption></figure>
        <figure class="sg-logo__tile sg-logo__tile--light"><img class="sg-logo__mark" src="/brand/mark/windward-mark-mono-ink.svg" width="300" height="300" alt="The mark in one colour: ink" loading="lazy" /><figcaption>mark-mono-ink</figcaption></figure>
        <figure class="sg-logo__tile sg-logo__tile--dark"><img class="sg-logo__mark" src="/brand/mark/windward-mark-mono-cream.svg" width="300" height="300" alt="The mark in one colour: cream" loading="lazy" /><figcaption>mark-mono-cream</figcaption></figure>
        <figure class="sg-logo__tile sg-logo__tile--dark"><img class="sg-logo__mark" src="/brand/mark/windward-mark-mono-gold.svg" width="300" height="300" alt="The mark in one colour: gold" loading="lazy" /><figcaption>mark-mono-gold</figcaption></figure>
      </div>

      <h3 class="sg-logo__label">App icon and favicon</h3>
      <div class="sg-logo__grid sg-logo__grid--2">
        <figure class="sg-logo__tile sg-logo__tile--light"><img class="sg-logo__app" src="/brand/icon/windward-app-icon-256.png" width="256" height="256" alt="The Windward Audio app icon" loading="lazy" /><figcaption>windward-app-icon (1024 / 512 / 256)</figcaption></figure>
        <figure class="sg-logo__tile sg-logo__tile--light">
          <div class="sg-logo__favicons">
            {[16, 32, 48].map((s) => (
              <span><img src="/brand/icon/windward-favicon.svg" width={s} height={s} alt={`The favicon at ${s} pixels`} loading="lazy" /><small>{s} px</small></span>
            ))}
          </div>
          <figcaption>windward-favicon.svg, simplified for small sizes (also favicon.ico)</figcaption>
        </figure>
      </div>
    </section>

    <!-- ── THE HOUSE ─────────────────────────────────────────────── -->
    <section id="house" class="sg-section wrap" aria-labelledby="house-title">
      <h2 id="house-title">The house</h2>
      <p class="lede">Shared by every page. Realms change colour, texture and the serif's mood, never the spacing, scale or rhythm.</p>

      <div class="sg-grid">
        <div class="stack">
          <h3>Typefaces</h3>
          <div class="face">
            <p class="face__sample display">Fraunces</p>
            <p class="muted">Display serif, variable. Its <em>Soft</em> and <em>Wonk</em> axes give each realm its own voice from one file: softer and more classical in fantasy, crisp and light in sci-fi. SIL OFL, self-hosted.</p>
          </div>
          <div class="face">
            <p class="face__sample face__sample--sans">Instrument Sans</p>
            <p class="muted">Body and interface. Clear, slightly narrow, a little warmth in the curves. SIL OFL, self-hosted.</p>
          </div>
          <div class="face">
            <p class="face__sample face__sample--mono">IBM PLEX MONO</p>
            <p class="muted">Small labels in the sci-fi realm only. SIL OFL, self-hosted.</p>
          </div>
          <div class="axes" aria-label="Fraunces in each realm">
            <p class="display" style="font-variation-settings:'SOFT' 100,'WONK' 1;font-weight:420">Windward <span class="muted">fantasy</span></p>
            <p class="display" style="font-variation-settings:'SOFT' 30,'WONK' 0;font-weight:360">Windward <span class="muted">house</span></p>
            <p class="display" style="font-variation-settings:'SOFT' 0,'WONK' 0;font-weight:300">Windward <span class="muted">sci-fi</span></p>
          </div>
        </div>

        <div class="stack">
          <h3>Type scale (fluid)</h3>
          <ol class="scale" role="list">
            {scale.map(([v, use]) => (
              <li><span class="scale__sample" style={`font-size: var(${v})`}>Places</span><code>{v}</code><span class="muted">{use}</span></li>
            ))}
          </ol>
        </div>
      </div>

      <div class="sg-grid">
        <div class="stack">
          <h3>Space</h3>
          <ul class="space" role="list">
            {space.map((s) => <li><span class="space__bar" style={`width: var(--space-${s})`}></span><code>--space-{s}</code></li>)}
          </ul>
        </div>
        <div class="stack">
          <h3>Ground, grain and motion</h3>
          <p>Every realm paints its own ground: a base colour, a fine SVG grain (generated in the browser, no image request) and, per realm, one extra layer: laid-paper lines and candle vignette in fantasy, two star fields and a faint grid in sci-fi.</p>
          <p>Motion is quiet: content rises gently into view, the threshold hero has slow parallax, stars twinkle and castle windows flicker. All of it is CSS only and switches off with <code>prefers-reduced-motion</code>. Audio never autoplays.</p>
          <h3>House palette &amp; contrast</h3>
          <ContrastTable realm="house" />
        </div>
      </div>

      <Ornament />
    </section>

    <!-- ── REALMS SIDE BY SIDE ───────────────────────────────────── -->
    <section id="realms" class="sg-section" aria-labelledby="realms-title">
      <div class="wrap stack">
        <h2 id="realms-title">Two realms, side by side</h2>
        <p class="lede">Same components, same markup. Only the <code>data-realm</code> attribute changes. Nav and footer are shown in each realm too; they collapse based on the space they have, which is why they look compact here.</p>
      </div>
      <div class="realms wrap-wide">
        <RealmPanel
          realm="fantasy"
          name="Fantasy"
          summary="Candlelit: warm ink-black lit from above, parchment-coloured type, candle gold and deep forest. Fraunces at its softest, etched ornaments, a gilt double rule on buttons and cards."
        />
        <RealmPanel
          realm="scifi"
          name="Sci-fi"
          summary="Deep-space navy with nebula violet and teal. Fraunces at its lightest and crispest, hairlines with corner brackets, monospace labels, faint stars and grid."
        />
      </div>
    </section>

    <!-- ── THRESHOLD ─────────────────────────────────────────────── -->
    <section id="threshold" class="sg-section" aria-labelledby="threshold-title">
      <div class="wrap stack">
        <h2 id="threshold-title">The threshold (home page hero)</h2>
        <p class="lede">One horizon, two worlds: ridges and a distant castle under a sunset, a city of towers in cool mist beneath a vast planet, and a slender lit doorway (our mark) on the seam. It is painted with SVG filters (fractal clouds, haze, mist, bloom) and rendered once by <code>npm run art</code> into a single image of about 50&nbsp;KB, served as AVIF/WebP. A tiny overlay keeps the castle candle, the beacon and a few stars alive. Scroll past it to see the drift.</p>
      </div>
      <div class="sg-hero" data-realm="threshold">
        <ThresholdHero>
          <p class="eyebrow">Windward Audio</p>
          <p class="display hero-line">Instruments for <em>places that don’t exist.</em></p>
          <p class="hero-sub">{/* TODO(copy): hero sub-line */}Instruments for film, TV and game composers. Each one is a doorway to somewhere else.</p>
          <div class="hero-ctas">
            <a class="btn btn--primary" href="#top">Enter WORLDBUILDER</a>
            <a class="btn" href="#top">Hear the places</a>
          </div>
        </ThresholdHero>
        <div class="wrap sg-threshold-below">
          <div class="sg-grid">
            <div class="stack">
              <h3>Threshold palette &amp; contrast</h3>
              <p class="muted">Dusk-dark ground, warm parchment ink, candle gold for action, teal for focus. It borrows from both realms without becoming either.</p>
              <AudioPlayer src="/audio/placeholder-02.mp3" peaks="placeholder-02" title="Crossroads at dusk" caption="Player in the threshold realm." />
            </div>
            <ContrastTable realm="threshold" />
          </div>
        </div>
      </div>
    </section>

    <!-- ── PRODUCT IDENTITY ──────────────────────────────────────── -->
    <section id="identity" class="sg-section wrap" aria-labelledby="identity-title">
      <h2 id="identity-title">Product identity inside the house</h2>
      <p class="lede">Products bring their own accent into the house. WORLDBUILDER's pixel art lives only in its screenshots, the tiny-planet motif and small accent details on its own page. Navigation, footer, body type and every other page stay in the house style.</p>
      <div class="identity" data-realm="scifi">
        <div class="identity__planet"><TinyPlanet size={240} /></div>
        <div class="stack">
          <p class="eyebrow">Product accent · WORLDBUILDER only</p>
          <p class="display identity__name">WORLDBUILDER</p>
          <p class="muted">The tiny planet: grassland and a castle on one side, plating and a lit spire on the other, because WORLDBUILDER covers both. Rendered as crisp SVG pixels, so it stays sharp at any size.</p>
          <p class="identity__rule"><span>Allowed:</span> screenshots, the planet, pixel corner accents on WORLDBUILDER sections. <span>Never:</span> nav, footer, headings, body text, other pages.</p>
        </div>
      </div>
    </section>

    <!-- ── PRODUCT REALMS ────────────────────────────────────────── -->
    <section id="product-realms" class="sg-section wrap-wide" aria-labelledby="product-realms-title">
      <h2 id="product-realms-title">Product realms</h2>
      <p class="lede">The later instruments each bring their own weather, used only on their own page and on their cards: LIMINAL’s fluorescent institution, DUNGEON CRAWLER’s red moon, LIGHT SEEKER’s sunlight.</p>
      <div class="sg-products">
        {([['liminal', 'LIMINAL', 'Pale mint under fluorescent tubes. Signage-style sans headings, camcorder mono labels, a REC-red focus ring.'],
           ['dungeon', 'DUNGEON CRAWLER', 'Ink black under a red moon. Engraved capitals on buttons, ember-red accents, candle-gold focus.'],
           ['radiant', 'LIGHT SEEKER', 'Sunlit ivory, gold and sky. Fraunces at its softest, rounded buttons.']] as const).map(([realm, name, note]) => (
          <article class="sg-product" data-realm={realm}>
            <p class="eyebrow">data-realm="{realm}"</p>
            <p class="display sg-product__name">{name}</p>
            <p class="muted">{note}</p>
            <div class="row"><a class="btn btn--primary" href={`#product-realms`}>Primary</a><a class="btn" href={`#product-realms`}>Secondary</a></div>
            <ContrastTable realm={realm} />
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .sg-intro { padding-block: var(--space-2xl) var(--space-xl); --stack-space: var(--space-m); }
  .sg-logo__label { font-size: var(--step-1); margin-block: var(--space-xl) var(--space-s); }
  .sg-logo__grid { display: grid; gap: var(--space-s); grid-template-columns: 1fr; }
  @media (min-width: 40rem) { .sg-logo__grid--2 { grid-template-columns: 1fr 1fr; } .sg-logo__grid--5 { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 64rem) { .sg-logo__grid--5 { grid-template-columns: repeat(5, 1fr); } }
  .sg-logo__tile { margin: 0; display: grid; gap: var(--space-s); justify-items: center; align-content: center; padding: var(--space-l) var(--space-m); border-radius: var(--radius); min-width: 0; }
  .sg-logo__tile--dark { background: var(--brand-ink); color: var(--brand-cream); }
  .sg-logo__tile--light { background: var(--brand-cream); color: var(--brand-ink); border: 1px solid var(--line); }
  .sg-logo__tile img { max-width: 100%; height: auto; }
  .sg-logo__tile > img:not([class]) { width: min(100%, 26rem); }
  .sg-logo__stacked { width: min(100%, 15rem); }
  .sg-logo__mark { width: min(100%, 7rem); }
  .sg-logo__app { width: 8rem; }
  .sg-logo__tile figcaption { font-family: var(--font-mono); font-size: var(--step--2); opacity: 0.8; text-align: center; overflow-wrap: anywhere; }
  .sg-logo__favicons { display: flex; align-items: end; gap: var(--space-l); }
  .sg-logo__favicons span { display: grid; justify-items: center; gap: var(--space-2xs); }
  .sg-logo__favicons small { font-family: var(--font-mono); font-size: var(--step--2); }
  .sg-toc { display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-l); font-size: var(--step--1); }
  .sg-section { padding-block: var(--space-2xl); }
  .sg-section > h2, .sg-section > .wrap > h2 { margin-bottom: var(--space-s); }
  .sg-section > .lede { margin-bottom: var(--space-xl); }
  .sg-grid { display: grid; gap: var(--space-xl); grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr)); margin-block: var(--space-xl); }
  .sg-grid h3 { font-size: var(--step-2); }

  .face { padding-block: var(--space-s); border-bottom: 1px solid var(--line); }
  .face__sample { font-size: var(--step-4); line-height: 1.1; }
  .face__sample--sans { font-family: var(--font-body); font-weight: 500; letter-spacing: -0.01em; }
  .face__sample--mono { font-family: var(--font-mono); font-size: var(--step-2); letter-spacing: 0.14em; }
  .axes p { font-size: var(--step-3); line-height: 1.25; }
  .axes .muted { font-family: var(--font-mono); font-size: var(--step--2); letter-spacing: 0.1em; text-transform: uppercase; }

  .scale { list-style: none; padding: 0; margin: 0; }
  .scale li { display: grid; grid-template-columns: 1fr auto 7rem; align-items: baseline; gap: var(--space-s); padding-block: 0.35rem; border-bottom: 1px solid var(--line); }
  .scale__sample { font-family: var(--font-display); font-variation-settings: var(--display-variation); line-height: 1.15; white-space: nowrap; overflow: hidden; }
  .scale code, .space code { font-family: var(--font-mono); font-size: var(--step--2); color: var(--ink-muted); }
  .scale .muted { font-size: var(--step--1); }

  .space { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-2xs); }
  .space li { display: flex; align-items: center; gap: var(--space-s); }
  .space__bar { height: 0.75rem; background: var(--accent); flex: none; }

  .realms { display: grid; gap: var(--space-m); grid-template-columns: 1fr; margin-top: var(--space-xl); }
  @media (min-width: 70rem) { .realms { grid-template-columns: 1fr 1fr; align-items: start; } }

  .sg-hero { margin-top: var(--space-xl); }
  .hero-line { font-size: var(--step-6); max-width: 15ch; line-height: 1.04; }
  .hero-line em { font-style: italic; font-weight: 300; color: #f6e7c8; }
  .hero-sub { font-size: var(--step-1); max-width: 40ch; color: var(--ink); opacity: 0.88; }
  .hero-ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-s); margin-top: var(--space-xs); }
  .sg-threshold-below { padding-block: var(--space-xl) var(--space-2xl); }

  .sg-products { display: grid; gap: var(--space-m); grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); }
  .sg-product { display: grid; gap: var(--space-s); align-content: start; padding: var(--space-l) var(--space-m); border: 1px solid var(--line-strong); min-width: 0; }
  .sg-product__name { font-size: var(--step-3); letter-spacing: 0.03em; }
  .sg-product .row { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .identity {
    display: grid; gap: var(--space-xl); align-items: center;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    padding: var(--space-xl); border: 1px solid var(--line-strong);
  }
  .identity__planet { display: grid; place-items: center; }
  .identity__planet :global(svg) { width: min(100%, 240px); height: auto; }
  .identity__name { font-size: min(var(--step-4), 8vw); letter-spacing: 0.04em; }
  .identity__rule { font-size: var(--step--1); }
  .identity__rule span { font-family: var(--font-mono); font-size: var(--step--2); letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent-text); }
</style>
