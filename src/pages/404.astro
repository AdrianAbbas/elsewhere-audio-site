---
// "Not found", themed: a door that opens onto empty space.
// Cloudflare Pages serves dist/404.html for any unknown path.
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import nebula from '../assets/art/atmosphere-nebula.webp';
---
<BaseLayout title="Place not found" description="This page doesn't exist." realm="house" noindex>
  <section class="lost" aria-labelledby="lost-title">
    <div class="lost__sky" aria-hidden="true">
      <Picture src={nebula} formats={['avif', 'webp']} fallbackFormat="webp" widths={[800]} sizes="100vw" alt="" loading="eager" />
    </div>
    <div class="lost__content wrap">
      <svg class="lost__door" viewBox="0 0 48 64" fill="none" aria-hidden="true">
        <path d="M6 62V24a18 18 0 0 1 36 0v38" stroke="currentColor" stroke-width="1.2" />
        <path d="M1 62h46" stroke="currentColor" stroke-width="1.2" />
      </svg>
      <p class="eyebrow">Error 404</p>
      <h1 id="lost-title">This place doesn’t exist… <em>yet.</em></h1>
      <p class="lede">The door you opened leads somewhere we haven’t built. Try one of these instead.</p>
      <nav class="lost__links" aria-label="Places to go">
        <a class="btn btn--primary" href="/">Back to the threshold</a>
        <a class="btn" href="/worldbuilder">WORLDBUILDER</a>
        <a class="btn" href="/support">Support</a>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .lost { position: relative; isolation: isolate; overflow: hidden; min-height: clamp(30rem, 75svh, 48rem); display: grid; place-items: center; }
  .lost__sky { position: absolute; inset: 0; z-index: -1; opacity: 0.55; -webkit-mask-image: radial-gradient(ellipse 70% 70% at 50% 45%, #000 30%, transparent 80%); mask-image: radial-gradient(ellipse 70% 70% at 50% 45%, #000 30%, transparent 80%); }
  .lost__sky :global(picture), .lost__sky :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .lost__content { display: grid; justify-items: center; gap: var(--space-m); text-align: center; padding-block: var(--space-2xl); }
  .lost__door { width: 3.5rem; color: var(--accent); filter: drop-shadow(0 0 12px rgb(227 181 102 / 0.5)); }
  .lost h1 { font-size: var(--step-5); max-width: 16ch; }
  .lost h1 em { font-style: italic; color: #f6e7c8; }
  .lost .lede { text-align: center; }
  .lost__links { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-s); margin-top: var(--space-xs); }
</style>
